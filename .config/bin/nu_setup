#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "📦 Installing dependencies"
pnpm install

echo "🏗️  Building everything except web"
pnpm exec turbo run build --filter='!web'

echo "🏞️ Setup .env files"
for env_file in ./apps/cli/.env ./server/.env; do
  grep -q '^NODE_ENV=' "$env_file" 2>/dev/null || echo "NODE_ENV=production" >>"$env_file"
done

SESS=$(tmux display-message -p -t "${TMUX_PANE:-}" '#S')
ICON="$(dirname "$0")/icons/nutiliti.png"

/usr/bin/perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die $!' bash -c '
RESULT=$(alerter --ignore-dnd --title "$1" --message "Worktree is ready" \
  --app-icon "$2" --group "$1:worktree" --timeout 1800 2>/dev/null)
if [[ "$RESULT" == "@CONTENTCLICKED" ]]; then
  sesh connect --switch "$1" || tmux switch-client -t "$1"
  open -b com.github.wez.wezterm
fi
' _ "$SESS" "$ICON" </dev/null >/dev/null 2>&1 &
