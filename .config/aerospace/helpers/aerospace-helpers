#!/usr/bin/env bash
#
# Gather every window onto one workspace, then send them all back home.
#
# Both operations use AeroSpace's own built-in tools, so there is no saved
# state to track or clean up:
#
#   gather  - collect all windows onto the target workspace (default: focused)
#   restore - re-run the [[on-window-detected]] rules in aerospace.toml for
#             every window, sending each app back to its assigned workspace
#
# Approach suggested by AeroSpace's author (nikitabobko):
#   https://github.com/nikitabobko/AeroSpace/discussions/2195
#
# Requires AeroSpace >= 0.21.0 (for `run-callback`).

set -euo pipefail

gather() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    target="$(aerospace list-workspaces --focused)"
  fi
  aerospace list-windows --all --format '%{window-id}' \
    | xargs -n1 aerospace move-node-to-workspace --fail-if-noop "$target" --window-id
  echo "Gathered all windows onto workspace '$target'."
}

restore() {
  aerospace run-callback --for-every-window on-window-detected
  echo "Restored windows to their assigned workspaces."
}

usage() {
  cat <<'EOF'
Usage:
  aerospace-helpers gather [workspace]   Collect all windows (default: focused workspace)
  aerospace-helpers restore              Send every window back to its home workspace
EOF
}

case "${1:-}" in
  gather)  shift; gather "${1:-}" ;;
  restore) restore ;;
  -h | --help | help | "") usage ;;
  *)
    echo "aerospace-helpers: unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
